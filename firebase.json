{
  "database": [
    {
      "target": "stacked-deck",
      "rules": "database.rules.json"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "stacked-deck",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "*.local"
      ],
      "predeploy": [
        "node tools/copy-game.js"
      ]
    },
    {
      "source": "ops",
      "codebase": "ops",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "*.local"
      ]
    }
  ],
  "emulators": {
    "hub": {
      "host": "127.0.0.1",
      "port": 4400
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4500
    },
    "database": {
      "host": "127.0.0.1",
      "port": 9000
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "eventarc": {
      "host": "127.0.0.1",
      "port": 9299
    },
    "tasks": {
      "host": "127.0.0.1",
      "port": 9499
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
