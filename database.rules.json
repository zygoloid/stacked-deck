{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com'"
    },
    "limits": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid",
        "submit": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid && newData.exists()",
          ".validate": "newData.hasChildren(['level', 'hash', 'at']) && (!data.exists() || now - data.child('at').val() >= 1000)",
          "level": { ".validate": "newData.isString() && newData.val().matches(/^(first-night|red-and-black|two-at-a-time|thursdays-game|threes-company|in-the-black|top-and-bottom|neighbours|lucky-seven|sevens-and-eights|seven-up|even-money|lucky-number|high-card|small-stakes|face-off|red-flush|small-change|high-suit|natural|low-kicker|crossed-wires|top-dog|pecking-order|royal-flush|acey-deucey|upper-hand|high-spade|top-pair|new-rules|bottom-dealer|upside-down|second-fiddle|knockout|low-ball|ace-count|bottom-pair|small-pairs|two-pair|hot-streak|high-roller|burn-card|third-time-lucky|full-house|the-wheel|calling-card|seven-heaven|suit-yourself|change-of-heart|next-in-line|jacks-or-better|house-record|mind-the-gap|straight-flush-draw|red-carpet|deja-vu|split-pot|checkerboard|two-apart|snap|three-apart|off-suit|every-other|bookends|top-of-the-heap|one-deck|penny-ante|cut-to-the-ace|uneven-tables|four-of-a-kind|missing-card|dumbwaiter|counting-up|ceasefire|three-in-a-row|in-between|rising|odds-and-evens|after-a-pair|two-by-two|royalty|rest-of-the-deck|crazy-eights|perfect-pair|pot-luck|night-off|skeleton-crew|no-kings|one-up|twenty-one-card-trick|round-the-clock|running-count|counterfeit|rank-and-file|head-count|mirror-image|casino-numbers|every-twenty-one|hit-me|punto-banco|split-the-difference|last-in-first-out|first-sighting|times-tables|showdown|follow-suit|twice-shy|carry-the-one|solitaire|opening-night|around-the-bar|two-tables|hearts-only|seeing-red|standing-room|black-tie|back-to-back|next-door|either-or|pair-night|inside-seven|beat-the-dealer|ace-in-the-hole|inside-bet)$/)" },
          "hash": { ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{32}$/)" },
          "at": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "solutions": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid",
        "$level": {
          ".validate": "$level.matches(/^(first-night|red-and-black|two-at-a-time|thursdays-game|threes-company|in-the-black|top-and-bottom|neighbours|lucky-seven|sevens-and-eights|seven-up|even-money|lucky-number|high-card|small-stakes|face-off|red-flush|small-change|high-suit|natural|low-kicker|crossed-wires|top-dog|pecking-order|royal-flush|acey-deucey|upper-hand|high-spade|top-pair|new-rules|bottom-dealer|upside-down|second-fiddle|knockout|low-ball|ace-count|bottom-pair|small-pairs|two-pair|hot-streak|high-roller|burn-card|third-time-lucky|full-house|the-wheel|calling-card|seven-heaven|suit-yourself|change-of-heart|next-in-line|jacks-or-better|house-record|mind-the-gap|straight-flush-draw|red-carpet|deja-vu|split-pot|checkerboard|two-apart|snap|three-apart|off-suit|every-other|bookends|top-of-the-heap|one-deck|penny-ante|cut-to-the-ace|uneven-tables|four-of-a-kind|missing-card|dumbwaiter|counting-up|ceasefire|three-in-a-row|in-between|rising|odds-and-evens|after-a-pair|two-by-two|royalty|rest-of-the-deck|crazy-eights|perfect-pair|pot-luck|night-off|skeleton-crew|no-kings|one-up|twenty-one-card-trick|round-the-clock|running-count|counterfeit|rank-and-file|head-count|mirror-image|casino-numbers|every-twenty-one|hit-me|punto-banco|split-the-difference|last-in-first-out|first-sighting|times-tables|showdown|follow-suit|twice-shy|carry-the-one|solitaire|opening-night|around-the-bar|two-tables|hearts-only|seeing-red|standing-room|black-tie|back-to-back|next-door|either-or|pair-night|inside-seven|beat-the-dealer|ace-in-the-hole|inside-bet)$/)",
          "$hash": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['cells', 'at', 'rules']) && newData.parent().parent().parent().parent().child('limits').child($uid).child('submit').child('level').val() === $level && newData.parent().parent().parent().parent().child('limits').child($uid).child('submit').child('hash').val() === $hash && newData.parent().parent().parent().parent().child('limits').child($uid).child('submit').child('at').val() === now",
            "cells": { ".validate": "newData.isString() && newData.val().length <= 10000" },
            "at": { ".validate": "newData.isNumber()" },
            "rules": { ".validate": "newData.val() === root.child('config').child('rulesVersion').val()" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "scores": {
      "$v": {
        "$uid": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).exists())"
        }
      }
    },
    "stats": {
      "$v": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com'"
      }
    },
    "best": {
      "$v": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com'"
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid",
        ".validate": "newData.hasChildren()",
        "$level": {
          ".validate": "$level.matches(/^(first-night|red-and-black|two-at-a-time|thursdays-game|threes-company|in-the-black|top-and-bottom|neighbours|lucky-seven|sevens-and-eights|seven-up|even-money|lucky-number|high-card|small-stakes|face-off|red-flush|small-change|high-suit|natural|low-kicker|crossed-wires|top-dog|pecking-order|royal-flush|acey-deucey|upper-hand|high-spade|top-pair|new-rules|bottom-dealer|upside-down|second-fiddle|knockout|low-ball|ace-count|bottom-pair|small-pairs|two-pair|hot-streak|high-roller|burn-card|third-time-lucky|full-house|the-wheel|calling-card|seven-heaven|suit-yourself|change-of-heart|next-in-line|jacks-or-better|house-record|mind-the-gap|straight-flush-draw|red-carpet|deja-vu|split-pot|checkerboard|two-apart|snap|three-apart|off-suit|every-other|bookends|top-of-the-heap|one-deck|penny-ante|cut-to-the-ace|uneven-tables|four-of-a-kind|missing-card|dumbwaiter|counting-up|ceasefire|three-in-a-row|in-between|rising|odds-and-evens|after-a-pair|two-by-two|royalty|rest-of-the-deck|crazy-eights|perfect-pair|pot-luck|night-off|skeleton-crew|no-kings|one-up|twenty-one-card-trick|round-the-clock|running-count|counterfeit|rank-and-file|head-count|mirror-image|casino-numbers|every-twenty-one|hit-me|punto-banco|split-the-difference|last-in-first-out|first-sighting|times-tables|showdown|follow-suit|twice-shy|carry-the-one|solitaire|opening-night|around-the-bar|two-tables|hearts-only|seeing-red|standing-room|black-tie|back-to-back|next-door|either-or|pair-night|inside-seven|beat-the-dealer|ace-in-the-hole|inside-bet)$/) && newData.hasChildren()",
          "work": {
            ".validate": "newData.hasChildren(['cells', 'at'])",
            "cells": { ".validate": "newData.isString() && newData.val().length <= 10000" },
            "at": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          },
          "solved": { ".validate": "newData.isBoolean()" },
          "deleted": {
            ".validate": "newData.hasChildren()",
            "$hash": { ".validate": "newData.val() === true && root.child('solutions').child($uid).child($level).child($hash).exists()" }
          },
          "$other": { ".validate": false }
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).exists())",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
        "$other": { ".validate": false }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid"
      }
    }
  }
}
