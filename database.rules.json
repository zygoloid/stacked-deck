{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com'"
    },
    "limits": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid",
        "submit": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid && newData.exists()",
          ".validate": "newData.hasChildren(['level', 'hash', 'at']) && (!data.exists() || now - data.child('at').val() >= 1000)",
          "level": { ".validate": "newData.isString() && newData.val().matches(/^(opening-night|around-the-bar|two-tables|hearts-only|seeing-red|standing-room|black-tie|back-to-back|next-door|lucky-seven|penny-ante|royalty|even-money|red-flush|either-or|pair-night|inside-seven|seven-up|lucky-number|beat-the-dealer|ace-in-the-hole|inside-bet|top-dog|top-of-the-heap|royal-flush|acey-deucey|upper-hand|high-spade|top-pair|new-rules|bottom-dealer|upside-down|second-fiddle|knockout|low-ball|ace-count|bottom-pair|small-pairs|two-pair|hot-streak|high-roller|burn-card|third-time-lucky|full-house|the-wheel|calling-card|seven-heaven|suit-yourself|change-of-heart|next-in-line|jacks-or-better|house-record|mind-the-gap|straight-flush-draw|red-carpet|deja-vu|small-change|split-pot|every-other|after-a-pair|bookends|four-of-a-kind|two-apart|three-apart|counting-up|rising|head-count|mirror-image|showdown|last-in-first-out|one-up)$/)" },
          "hash": { ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{32}$/)" },
          "at": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "solutions": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid",
        "$level": {
          ".validate": "$level.matches(/^(opening-night|around-the-bar|two-tables|hearts-only|seeing-red|standing-room|black-tie|back-to-back|next-door|lucky-seven|penny-ante|royalty|even-money|red-flush|either-or|pair-night|inside-seven|seven-up|lucky-number|beat-the-dealer|ace-in-the-hole|inside-bet|top-dog|top-of-the-heap|royal-flush|acey-deucey|upper-hand|high-spade|top-pair|new-rules|bottom-dealer|upside-down|second-fiddle|knockout|low-ball|ace-count|bottom-pair|small-pairs|two-pair|hot-streak|high-roller|burn-card|third-time-lucky|full-house|the-wheel|calling-card|seven-heaven|suit-yourself|change-of-heart|next-in-line|jacks-or-better|house-record|mind-the-gap|straight-flush-draw|red-carpet|deja-vu|small-change|split-pot|every-other|after-a-pair|bookends|four-of-a-kind|two-apart|three-apart|counting-up|rising|head-count|mirror-image|showdown|last-in-first-out|one-up)$/)",
          "$hash": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['cells', 'at', 'rules']) && newData.parent().parent().parent().parent().child('limits').child($uid).child('submit').child('level').val() === $level && newData.parent().parent().parent().parent().child('limits').child($uid).child('submit').child('hash').val() === $hash && newData.parent().parent().parent().parent().child('limits').child($uid).child('submit').child('at').val() === now",
            "cells": { ".validate": "newData.isString() && newData.val().length <= 10000" },
            "at": { ".validate": "newData.isNumber()" },
            "rules": { ".validate": "newData.val() === root.child('config').child('rulesVersion').val()" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "scores": {
      "$v": {
        "$uid": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).exists())"
        }
      }
    },
    "stats": {
      "$v": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com'"
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid",
        ".validate": "newData.hasChildren()",
        "$level": {
          ".validate": "$level.matches(/^(opening-night|around-the-bar|two-tables|hearts-only|seeing-red|standing-room|black-tie|back-to-back|next-door|lucky-seven|penny-ante|royalty|even-money|red-flush|either-or|pair-night|inside-seven|seven-up|lucky-number|beat-the-dealer|ace-in-the-hole|inside-bet|top-dog|top-of-the-heap|royal-flush|acey-deucey|upper-hand|high-spade|top-pair|new-rules|bottom-dealer|upside-down|second-fiddle|knockout|low-ball|ace-count|bottom-pair|small-pairs|two-pair|hot-streak|high-roller|burn-card|third-time-lucky|full-house|the-wheel|calling-card|seven-heaven|suit-yourself|change-of-heart|next-in-line|jacks-or-better|house-record|mind-the-gap|straight-flush-draw|red-carpet|deja-vu|small-change|split-pot|every-other|after-a-pair|bookends|four-of-a-kind|two-apart|three-apart|counting-up|rising|head-count|mirror-image|showdown|last-in-first-out|one-up)$/) && newData.hasChildren()",
          "work": {
            ".validate": "newData.hasChildren(['cells', 'at'])",
            "cells": { ".validate": "newData.isString() && newData.val().length <= 10000" },
            "at": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          },
          "solved": { ".validate": "newData.isBoolean()" },
          "deleted": {
            ".validate": "newData.hasChildren()",
            "$hash": { ".validate": "newData.val() === true && root.child('solutions').child($uid).child($level).child($hash).exists()" }
          },
          "$other": { ".validate": false }
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).exists())",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
        "$other": { ".validate": false }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.uid === $uid"
      }
    }
  }
}
